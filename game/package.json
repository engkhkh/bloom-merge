{
  "name": "bloom-merge",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win --x64"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "phaser": "^3.80.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "main": "electron/main.cjs",
  "description": "Bloom Merge - a calm merge-and-grow garden puzzle",
  "author": "Bloom Merge",
  "build": {
    "appId": "com.bloommerge.game",
    "productName": "Bloom Merge",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icons/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
